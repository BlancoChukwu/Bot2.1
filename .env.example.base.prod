# Base production config - zero-capital liquidation bot
CHAIN=base
WS_RPC_URL_PRIMARY=your_quicknode_ws_url_here
WS_RPC_URL_SECONDARY=your_alchemy_ws_url_here
WS_RPC_URL_TERTIARY=your_chainstack_ws_url_here
EXECUTION_RPC_URL_PRIMARY=your_quicknode_http_url_here
EXECUTION_RPC_URL_FALLBACKS=your_alchemy_http_url_here
PRIVATE_TX_MODE=sequencer_direct
FLASH_LOAN_PROVIDERS=aaveV3,balancer
LIQUIDATION_RECEIVER_ADDRESS=0xYOUR_DEPLOYED_RECEIVER_HERE   # ← deploy this once
FTRL_ROLLOUT_PCT=10                                        # start low, ramp to 100
MIN_PROFIT_THRESHOLD_USD=5                                 # bootstrap, FTRL will adapt
BENCHMARK_DRY=true                                         # safety for first runs
