{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liquidator Cockpit",
  "version": "2.0.0",
  "identifier": "com.liquidator.cockpit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5179",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-v2"
  },
  "app": {
    "windows": [
      {
        "title": "Liquidator Cockpit",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
