{
  "name": "optimism-aave-v3-liquidator-ts",
  "version": "1.0.0",
  "description": "Chain-agnostic Aave V3 liquidation bot with Optimism as the first active target.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "start": "node dist/src/index.js",
    "bot:status": "node scripts/ensure-single-bot.mjs --status",
    "bot:stop": "node scripts/ensure-single-bot.mjs --stop",
    "start:sim": "ts-node src/index.ts",
    "start:live": "cross-env SIMULATION_MODE=false ts-node src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --pool=forks --no-file-parallelism",
    "test:watch": "vitest",
    "benchmark:base": "ts-node test/integration/benchmark.replay.ts",
    "replay:historical": "ts-node scripts/replay-historical.ts",
    "replay:liquidation-block": "ts-node scripts/replay-liquidation-block.ts",
    "probe:multicall-base": "ts-node scripts/multicall-batch-probe-base.ts",
    "debug:hf-sweep-base": "ts-node scripts/debug-hf-sweep-base.ts",
    "test:chaos": "vitest run --pool=forks --no-file-parallelism --testNamePattern=chaos",
    "rust:build": "cd rust-hotpath && cargo build --release",
    "compile:contracts": "node scripts/compile-liquidation-receiver.mjs",
    "deploy:liquidation-receiver:base": "ts-node scripts/deploy-liquidation-receiver-base.ts",
    "redis:ensure": "node scripts/ensure-redis.mjs",
    "dry-run:receipt": "node scripts/ensure-redis.mjs && npm run build && node scripts/emit-dry-run-receipt.mjs --live && node scripts/apply-dry-run-receipt-to-env.mjs",
    "audit:watchlist-base": "node scripts/audit-watchlist-base.mjs",
    "audit:dex-surface-base": "node scripts/audit-dex-surface-base.mjs",
    "test:flashblocks": "node scripts/flashblocks-connection-test.mjs",
    "review:daily-pipeline": "node scripts/daily-pipeline-review.mjs",
    "pairs:top-base": "node scripts/select-top-base-pairs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@arbitrum/sdk": "^4.0.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "viem": "^2.48.4",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.6",
    "cross-env": "^10.1.0",
    "solc": "^0.8.26",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
