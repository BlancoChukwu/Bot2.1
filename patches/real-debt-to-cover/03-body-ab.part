diff --git a/src/protocols/liquidationSizing.ts b/src/protocols/liquidationSizing.ts
new file mode 100644
index 0000000..fcb5238
--- /dev/null
+++ b/src/protocols/liquidationSizing.ts
@@ -0,0 +1,179 @@
+import type { Address } from "viem";
+import { defaultCloseFactorBps } from "../config/aavePoolVersion";
+import type { AaveReservePair } from "../config/chains";
+import type { AaveReservePosition } from "./aaveReservePositions";
+
+const bpsDenominator = 10_000n;
+const fullCloseFactorBps = 10_000;
+/** Aave v3.3+ LiquidationLogic.MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD (8-dec USD base). */
+export const MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD = 2_000n * 100_000_000n;
+
+export interface LiquidationSizingInput {
+  readonly reserves: readonly AaveReservePosition[];
+  readonly pairs: readonly AaveReservePair[];
+  readonly healthFactor: bigint;
+  /** getUserAccountData.totalDebtBase (8-dec USD). Close-factor cap = 50% of TOTAL debt, per Aave LiquidationLogic. */
+  readonly totalDebtBase?: bigint;
+  /**
+   * Aave v3.3+ rule: if the chosen reserve's collateral OR debt is < $2,000 base, close factor is 100%.
+   * Not enabled by default (repo models plain v3 50/100 via defaultCloseFactorBps); see report.
+   */
+  readonly smallPositionFullClose?: boolean;
+}
+
+export interface LiquidationPlan {
+  readonly collateralAsset: Address;
+  readonly debtAsset: Address;
+  readonly debtDecimals: number;
+  readonly collateralDecimals: number;
+  readonly debtPriceUsd8: bigint;
+  readonly collateralPriceUsd8: bigint;
+  /** Sized amount (native debt decimals) = min(actual debt, close-factor cap, collateral cap). */
+  readonly debtToCover: bigint;
+  readonly debtToCoverUsd: number;
+  /** Actual (variable + stable) debt of the chosen debt reserve, native decimals. */
+  readonly actualDebtRaw: bigint;
+  readonly actualDebtUsd: number;
+  readonly collateralBalanceRaw: bigint;
+  readonly collateralUsd: number;
+  readonly totalDebtUsd?: number;
+  readonly closeFactorBps: number;
+  readonly liquidationBonusBps: number;
+  readonly cappedBy: "actual_debt" | "close_factor" | "collateral";
+}
+
+export type LiquidationSizingResult =
+  | { readonly kind: "planned"; readonly plan: LiquidationPlan }
+  | {
+    readonly kind: "pair_not_held";
+    readonly heldDebtAssets: readonly Address[];
+    readonly heldCollateralAssets: readonly Address[];
+  };
+
+export function reserveUsd8(raw: bigint, decimals: number, priceUsd8: bigint): bigint {
+  if (raw <= 0n || priceUsd8 <= 0n) {
+    return 0n;
+  }
+  return (raw * priceUsd8) / 10n ** BigInt(decimals);
+}
+
+export function usd8ToNumber(value: bigint): number {
+  return Number(value) / 1e8;
+}
+
+function totalDebt(reserve: AaveReservePosition): bigint {
+  return reserve.variableDebt + reserve.stableDebt;
+}
+
+function sameAddress(left: string, right: string): boolean {
+  return left.toLowerCase() === right.toLowerCase();
+}
+
+/**
+ * Choose the liquidation pair from ACTUAL holdings and size debtToCover.
+ * - debt asset: largest-USD debt reserve that is a configured pair debt asset (falls through to the next
+ *   largest if no held collateral forms a configured pair with it)
+ * - collateral: largest-USD collateral reserve with usageAsCollateralEnabled that forms a configured pair
+ * - debtToCover = min(actual debt, close-factor cap, collateral cap)
+ */
+export function planAaveLiquidation(input: LiquidationSizingInput): LiquidationSizingResult {
+  const debtReserves = input.reserves
+    .filter((reserve) => totalDebt(reserve) > 0n)
+    .filter((reserve) => input.pairs.some((pair) => sameAddress(pair.debtAsset, reserve.asset)))
+    .sort((left, right) => compareDesc(
+      reserveUsd8(totalDebt(left), left.decimals, left.priceUsd8),
+      reserveUsd8(totalDebt(right), right.decimals, right.priceUsd8),
+    ));
+  const collateralReserves = input.reserves
+    .filter((reserve) => reserve.usageAsCollateralEnabled && reserve.collateralBalance > 0n)
+    .sort((left, right) => compareDesc(
+      reserveUsd8(left.collateralBalance, left.decimals, left.priceUsd8),
+      reserveUsd8(right.collateralBalance, right.decimals, right.priceUsd8),
+    ));
+
+  for (const debt of debtReserves) {
+    for (const collateral of collateralReserves) {
+      const pair = input.pairs.find(
+        (candidate) => sameAddress(candidate.debtAsset, debt.asset) && sameAddress(candidate.collateralAsset, collateral.asset),
+      );
+      if (pair === undefined) {
+        continue;
+      }
+      return { kind: "planned", plan: sizePlan(input, debt, collateral, pair) };
+    }
+  }
+
+  return {
+    kind: "pair_not_held",
+    heldDebtAssets: input.reserves.filter((reserve) => totalDebt(reserve) > 0n).map((reserve) => reserve.asset),
+    heldCollateralAssets: collateralReserves.map((reserve) => reserve.asset),
+  };
+}
+
+function sizePlan(
+  input: LiquidationSizingInput,
+  debt: AaveReservePosition,
+  collateral: AaveReservePosition,
+  pair: AaveReservePair,
+): LiquidationPlan {
+  const actualDebtRaw = totalDebt(debt);
+  const debtUnit = 10n ** BigInt(debt.decimals);
+  const collateralUnit = 10n ** BigInt(collateral.decimals);
+  const reserveDebtBase = reserveUsd8(actualDebtRaw, debt.decimals, debt.priceUsd8);
+  const reserveCollateralBase = reserveUsd8(collateral.collateralBalance, collateral.decimals, collateral.priceUsd8);
+
+  let closeFactorBps = defaultCloseFactorBps("v3", input.healthFactor);
+  if (
+    input.smallPositionFullClose === true
+    && (reserveDebtBase < MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD || reserveCollateralBase < MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD)
+  ) {
+    closeFactorBps = fullCloseFactorBps;
+  }
+
+  let debtToCover = actualDebtRaw;
+  let cappedBy: LiquidationPlan["cappedBy"] = "actual_debt";
+  if (closeFactorBps < fullCloseFactorBps) {
+    const closeFactorCap = input.totalDebtBase !== undefined && input.totalDebtBase > 0n
+      ? (((input.totalDebtBase * BigInt(closeFactorBps)) / bpsDenominator) * debtUnit) / debt.priceUsd8
+      : (actualDebtRaw * BigInt(closeFactorBps)) / bpsDenominator;
+    if (closeFactorCap < debtToCover) {
+      debtToCover = closeFactorCap;
+      cappedBy = "close_factor";
+    }
+  }
+
+  // Collateral cap: debtToCover * (1 + bonus) must not exceed the chosen collateral balance (USD).
+  const bonusMultiplierBps = bpsDenominator + BigInt(pair.liquidationBonusBps);
+  const collateralCap = (collateral.collateralBalance * collateral.priceUsd8 * debtUnit * bpsDenominator)
+    / (collateralUnit * debt.priceUsd8 * bonusMultiplierBps);
+  if (collateralCap < debtToCover) {
+    debtToCover = collateralCap;
+    cappedBy = "collateral";
+  }
+
+  return {
+    collateralAsset: collateral.asset,
+    debtAsset: debt.asset,
+    debtDecimals: debt.decimals,
+    collateralDecimals: collateral.decimals,
+    debtPriceUsd8: debt.priceUsd8,
+    collateralPriceUsd8: collateral.priceUsd8,
+    debtToCover,
+    debtToCoverUsd: usd8ToNumber(reserveUsd8(debtToCover, debt.decimals, debt.priceUsd8)),
+    actualDebtRaw,
+    actualDebtUsd: usd8ToNumber(reserveDebtBase),
+    collateralBalanceRaw: collateral.collateralBalance,
+    collateralUsd: usd8ToNumber(reserveCollateralBase),
+    ...(input.totalDebtBase === undefined ? {} : { totalDebtUsd: usd8ToNumber(input.totalDebtBase) }),
+    closeFactorBps,
+    liquidationBonusBps: pair.liquidationBonusBps,
+    cappedBy,
+  };
+}
+
+function compareDesc(left: bigint, right: bigint): number {
+  if (left === right) {
+    return 0;
+  }
+  return left > right ? -1 : 1;
+}
