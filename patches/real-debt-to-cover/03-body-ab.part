diff --git a/src/protocols/aaveReservePositions.ts b/src/protocols/aaveReservePositions.ts
new file mode 100644
index 0000000..0745168
--- /dev/null
+++ b/src/protocols/aaveReservePositions.ts
@@ -0,0 +1,348 @@
+import type { Address } from "viem";
+import { uiPoolDataProviderAbi } from "./uiPoolDataProvider";
+
+/**
+ * Real per-reserve Aave V3 positions for liquidation sizing.
+ *
+ * One multicall per batch of accounts:
+ *   - UiPoolDataProvider.getUserReservesData(provider, user) per account (scaled balances + collateral flag)
+ *   - Pool.getReserveNormalizedIncome / getReserveNormalizedVariableDebt per tracked asset (current indices)
+ *   - AaveOracle.getAssetPrice per tracked asset (8-dec USD base)
+ *   - ERC20.decimals per tracked asset (cached after first successful read)
+ * Real balance = scaled * index / RAY with protocol rounding (v3.4+ TokenMath): collateral (aToken) rounds
+ * DOWN, variable debt rounds UP — this reproduces getUserAccountData.totalDebtBase exactly (verified on the
+ * 0xf20e replay: 10 scaled sats cbBTC -> 11 sats debt -> 923715 base).
+ * Stable debt is not exposed by the v3.2+ UserReserveData struct (stable rate removed) and is reported as 0.
+ */
+
+const RAY = 10n ** 27n;
+
+export function rayMulFloor(a: bigint, b: bigint): bigint {
+  return (a * b) / RAY;
+}
+
+export function rayMulCeil(a: bigint, b: bigint): bigint {
+  const product = a * b;
+  if (product === 0n) {
+    return 0n;
+  }
+  return (product + RAY - 1n) / RAY;
+}
+
+export const aavePoolIndexAbi = [
+  {
+    type: "function",
+    name: "getReserveNormalizedIncome",
+    stateMutability: "view",
+    inputs: [{ name: "asset", type: "address" }],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+  {
+    type: "function",
+    name: "getReserveNormalizedVariableDebt",
+    stateMutability: "view",
+    inputs: [{ name: "asset", type: "address" }],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+] as const;
+
+export const poolAddressesProviderOracleAbi = [
+  {
+    type: "function",
+    name: "getPriceOracle",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [{ name: "", type: "address" }],
+  },
+] as const;
+
+export const aaveOracleAssetPriceAbi = [
+  {
+    type: "function",
+    name: "getAssetPrice",
+    stateMutability: "view",
+    inputs: [{ name: "asset", type: "address" }],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+] as const;
+
+export const erc20DecimalsAbi = [
+  {
+    type: "function",
+    name: "decimals",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [{ name: "", type: "uint8" }],
+  },
+] as const;
+
+export interface AaveReservePosition {
+  readonly asset: Address;
+  readonly decimals: number;
+  /** Aave oracle price, 8-decimal USD base. */
+  readonly priceUsd8: bigint;
+  readonly collateralBalance: bigint;
+  readonly variableDebt: bigint;
+  readonly stableDebt: bigint;
+  readonly usageAsCollateralEnabled: boolean;
+}
+
+export interface UntrackedReserveHolding {
+  readonly asset: Address;
+  readonly hasDebt: boolean;
+  readonly hasCollateral: boolean;
+}
+
+export interface AaveAccountReservePositions {
+  readonly account: Address;
+  readonly reserves: readonly AaveReservePosition[];
+  /** Held reserves outside the tracked (configured-pair) asset set — cannot be liquidated by this bot. */
+  readonly untrackedReserves?: readonly UntrackedReserveHolding[];
+}
+
+export type AccountReservePositionsResult =
+  | { readonly ok: true; readonly positions: AaveAccountReservePositions }
+  | { readonly ok: false; readonly error: string };
+
+export type MulticallResultLike =
+  | { readonly status: "success"; readonly result: unknown }
+  | { readonly status: "failure"; readonly error: unknown };
+
+export interface ReservePositionsMulticallClient {
+  multicall(parameters: {
+    readonly contracts: readonly unknown[];
+    readonly allowFailure: true;
+    readonly blockNumber?: bigint;
+  }): Promise<readonly MulticallResultLike[]>;
+}
+
+export interface ReservePositionsAddresses {
+  readonly pool: Address;
+  readonly poolAddressesProvider: Address;
+  readonly uiPoolDataProvider: Address;
+  /** Optional explicit AaveOracle; otherwise resolved once via PoolAddressesProvider.getPriceOracle(). */
+  readonly oracle?: Address;
+}
+
+export interface ResolveReservePositionsInput {
+  readonly client: ReservePositionsMulticallClient;
+  readonly addresses: ReservePositionsAddresses;
+  readonly accounts: readonly Address[];
+  /** Reserves relevant to liquidation (configured pair assets). */
+  readonly assets: readonly Address[];
+  readonly decimalsCache?: Map<string, number>;
+  readonly blockNumber?: bigint;
+  readonly maxAccountsPerCall?: number;
+}
+
+interface AssetMarketData {
+  readonly liquidityIndex: bigint;
+  readonly variableBorrowIndex: bigint;
+  readonly priceUsd8: bigint;
+  readonly decimals: number;
+}
+
+interface UserReserveRow {
+  readonly underlyingAsset: Address;
+  readonly scaledATokenBalance: bigint;
+  readonly usageAsCollateralEnabledOnUser: boolean;
+  readonly scaledVariableDebt: bigint;
+}
+
+export function asReservePositionsMulticallClient(client: unknown): ReservePositionsMulticallClient | undefined {
+  const candidate = client as { multicall?: unknown } | undefined;
+  if (candidate === undefined || candidate === null || typeof candidate.multicall !== "function") {
+    return undefined;
+  }
+  return client as ReservePositionsMulticallClient;
+}
+
+export async function resolveOracleAddress(
+  client: ReservePositionsMulticallClient,
+  addresses: ReservePositionsAddresses,
+  blockNumber?: bigint,
+): Promise<Address> {
+  if (addresses.oracle !== undefined) {
+    return addresses.oracle;
+  }
+  const [result] = await client.multicall({
+    contracts: [{
+      address: addresses.poolAddressesProvider,
+      abi: poolAddressesProviderOracleAbi,
+      functionName: "getPriceOracle",
+    }],
+    allowFailure: true,
+    ...(blockNumber === undefined ? {} : { blockNumber }),
+  });
+  if (result?.status !== "success" || typeof result.result !== "string") {
+    throw new Error("getPriceOracle failed");
+  }
+  return result.result as Address;
+}
+
+/**
+ * Resolve real per-reserve positions for many accounts. Never throws for per-account problems:
+ * each account maps to `{ ok: false, error }` so callers can log `debt_to_cover_resolve_failed` and skip.
+ * Throws only when the transport itself fails (caller may retry once).
+ */
+export async function resolveAccountReservePositions(
+  input: ResolveReservePositionsInput & { readonly oracle: Address },
+): Promise<Map<string, AccountReservePositionsResult>> {
+  const out = new Map<string, AccountReservePositionsResult>();
+  const accounts = dedupe(input.accounts);
+  if (accounts.length === 0) {
+    return out;
+  }
+  const assets = dedupe(input.assets);
+  const decimalsCache = input.decimalsCache ?? new Map<string, number>();
+  const chunkSize = Math.max(1, input.maxAccountsPerCall ?? 100);
+
+  for (let offset = 0; offset < accounts.length; offset += chunkSize) {
+    const chunk = accounts.slice(offset, offset + chunkSize);
+    const uncachedDecimals = assets.filter((asset) => !decimalsCache.has(asset.toLowerCase()));
+    const contracts: unknown[] = [
+      ...chunk.map((account) => ({
+        address: input.addresses.uiPoolDataProvider,
+        abi: uiPoolDataProviderAbi,
+        functionName: "getUserReservesData",
+        args: [input.addresses.poolAddressesProvider, account],
+      })),
+      ...assets.flatMap((asset) => [
+        { address: input.addresses.pool, abi: aavePoolIndexAbi, functionName: "getReserveNormalizedIncome", args: [asset] },
+        { address: input.addresses.pool, abi: aavePoolIndexAbi, functionName: "getReserveNormalizedVariableDebt", args: [asset] },
+        { address: input.oracle, abi: aaveOracleAssetPriceAbi, functionName: "getAssetPrice", args: [asset] },
+      ]),
+      ...uncachedDecimals.map((asset) => ({ address: asset, abi: erc20DecimalsAbi, functionName: "decimals" })),
+    ];
+    const results = await input.client.multicall({
+      contracts,
+      allowFailure: true,
+      ...(input.blockNumber === undefined ? {} : { blockNumber: input.blockNumber }),
+    });
+    if (results.length !== contracts.length) {
+      throw new Error(`multicall returned ${results.length} results for ${contracts.length} calls`);
+    }
+
+    const decimalsOffset = chunk.length + assets.length * 3;
+    uncachedDecimals.forEach((asset, index) => {
+      const response = results[decimalsOffset + index];
+      if (response?.status === "success") {
+        const value = Number(response.result);
+        if (Number.isInteger(value) && value >= 0 && value <= 36) {
+          decimalsCache.set(asset.toLowerCase(), value);
+        }
+      }
+    });
+
+    const market = new Map<string, AssetMarketData>();
+    const marketErrors: string[] = [];
+    assets.forEach((asset, index) => {
+      const base = chunk.length + index * 3;
+      const income = results[base];
+      const variable = results[base + 1];
+      const price = results[base + 2];
+      const decimals = decimalsCache.get(asset.toLowerCase());
+      if (
+        income?.status !== "success" || variable?.status !== "success" || price?.status !== "success"
+        || typeof income.result !== "bigint" || typeof variable.result !== "bigint" || typeof price.result !== "bigint"
+        || price.result <= 0n || decimals === undefined
+      ) {
+        marketErrors.push(asset);
+        return;
+      }
+      market.set(asset.toLowerCase(), {
+        liquidityIndex: income.result,
+        variableBorrowIndex: variable.result,
+        priceUsd8: price.result,
+        decimals,
+      });
+    });
+
+    chunk.forEach((account, index) => {
+      const key = account.toLowerCase();
+      const response = results[index];
+      if (response?.status !== "success") {
+        out.set(key, { ok: false, error: `getUserReservesData_failed:${errorMessage(response)}` });
+        return;
+      }
+      const rows = extractRows(response.result);
+      if (rows === undefined) {
+        out.set(key, { ok: false, error: "getUserReservesData_malformed" });
+        return;
+      }
+      const reserves: AaveReservePosition[] = [];
+      const untrackedReserves: UntrackedReserveHolding[] = [];
+      let missingMarket: string | undefined;
+      for (const row of rows) {
+        if (row.scaledATokenBalance === 0n && row.scaledVariableDebt === 0n) {
+          continue;
+        }
+        const assetKey = row.underlyingAsset.toLowerCase();
+        const data = market.get(assetKey);
+        if (data === undefined) {
+          if (marketErrors.some((asset) => asset.toLowerCase() === assetKey)) {
+            missingMarket = row.underlyingAsset;
+          }
+          // Reserve outside tracked (configured-pair) assets: not liquidatable by this bot.
+          untrackedReserves.push({
+            asset: row.underlyingAsset,
+            hasDebt: row.scaledVariableDebt > 0n,
+            hasCollateral: row.scaledATokenBalance > 0n && row.usageAsCollateralEnabledOnUser,
+          });
+          continue;
+        }
+        reserves.push({
+          asset: row.underlyingAsset,
+          decimals: data.decimals,
+          priceUsd8: data.priceUsd8,
+          collateralBalance: rayMulFloor(row.scaledATokenBalance, data.liquidityIndex),
+          variableDebt: rayMulCeil(row.scaledVariableDebt, data.variableBorrowIndex),
+          stableDebt: 0n,
+          usageAsCollateralEnabled: row.usageAsCollateralEnabledOnUser,
+        });
+      }
+      if (missingMarket !== undefined) {
+        out.set(key, { ok: false, error: `reserve_market_data_failed:${missingMarket}` });
+        return;
+      }
+      out.set(key, { ok: true, positions: { account, reserves, untrackedReserves } });
+    });
+  }
+  return out;
+}
+
+function extractRows(result: unknown): readonly UserReserveRow[] | undefined {
+  if (!Array.isArray(result)) {
+    return undefined;
+  }
+  const rows = result[0];
+  if (!Array.isArray(rows)) {
+    return undefined;
+  }
+  return rows as readonly UserReserveRow[];
+}
+
+function errorMessage(response: MulticallResultLike | undefined): string {
+  if (response === undefined) {
+    return "missing";
+  }
+  if (response.status === "failure") {
+    const error = response.error;
+    return error instanceof Error ? error.message.split("\n")[0] ?? "error" : String(error);
+  }
+  return "unknown";
+}
+
+function dedupe(addresses: readonly Address[]): Address[] {
+  const seen = new Set<string>();
+  const out: Address[] = [];
+  for (const address of addresses) {
+    const key = address.toLowerCase();
+    if (seen.has(key)) {
+      continue;
+    }
+    seen.add(key);
+    out.push(address);
+  }
+  return out;
+}
