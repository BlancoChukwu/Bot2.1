+  /** One batched resolution for all accounts; failed accounts get exactly one retry (also batched). */
+  private async resolvePositionsWithRetry(
+    accounts: readonly Address[],
+  ): Promise<Map<string, AccountReservePositionsResult>> {
+    const out = new Map<string, AccountReservePositionsResult>();
+    if (this.protocol.getAccountReservePositions === undefined) {
+      for (const account of accounts) {
+        out.set(account.toLowerCase(), { ok: false, error: "protocol_missing_getAccountReservePositions" });
+      }
+      return out;
+    }
+    let pending = [...accounts];
+    for (let attempt = 0; attempt < 2 && pending.length > 0; attempt += 1) {
+      let batch: ReadonlyMap<string, AccountReservePositionsResult>;
+      try {
+        batch = await this.protocol.getAccountReservePositions(pending);
+      } catch (error) {
+        const message = error instanceof Error ? error.message.split("\n")[0] ?? "error" : String(error);
+        for (const account of pending) {
+          out.set(account.toLowerCase(), { ok: false, error: `resolve_threw:${message}` });
+        }
+        continue;
+      }
+      for (const account of pending) {
+        out.set(account.toLowerCase(), batch.get(account.toLowerCase()) ?? { ok: false, error: "missing_from_batch" });
+      }
+      pending = pending.filter((account) => out.get(account.toLowerCase())?.ok !== true);
     }
+    return out;
+  }
 
