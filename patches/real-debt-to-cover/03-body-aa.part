+
+/** Sizing fields logged on EVERY liquidation_evaluated (pass or fail, including dust rejects). */
+function sizingLogFields(candidate: LiquidationCandidate, resolved: ResolvedDebtUsd): Record<string, unknown> {
+  return {
+    debtAsset: candidate.debtAsset,
+    collateralAsset: candidate.collateralAsset,
+    debtToCover: candidate.debtToCover.toString(),
+    debtToCoverUsd: resolved.debtUsd,
+    actualDebtUsd: resolved.actualDebtUsd ?? candidate.actualDebtUsd ?? null,
+    actualDebtRaw: candidate.actualDebtRaw?.toString() ?? null,
+    closeFactorBps: candidate.appliedCloseFactorBps ?? null,
+    debtDecimals: candidate.debtDecimals ?? null,
+    totalDebtUsd: candidate.totalDebtUsd ?? null,
+    sizingCappedBy: candidate.sizingCappedBy ?? null,
+  };
+}
+
