+    debtToCover: plan.debtToCover.toString(),
+    debtToCoverUsd: plan.debtToCoverUsd,
+    actualDebtUsd: plan.actualDebtUsd,
+    actualDebtRaw: plan.actualDebtRaw.toString(),
+    closeFactorBps: plan.closeFactorBps,
+    debtDecimals: plan.debtDecimals,
+    totalDebtUsd: plan.totalDebtUsd ?? null,
+    sizingCappedBy: plan.cappedBy,
+  };
+}
