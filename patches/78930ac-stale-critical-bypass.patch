--- a/src/index.ts
+++ b/src/index.ts
@@ -1088,6 +1088,7 @@ function buildPipelineBot(config: RuntimeConfig, metrics: BotMetrics): BotRunner
           chain: config.chain,
           account: candidate.account,
           healthFactor: Number(candidate.confirmed.healthFactor) / 1e18,
+          totalDebtBase: candidate.confirmed.totalDebtBase.toString(),
           simulationMode: config.simulationMode,
           enableLiveTx: config.eventPurity.enableLiveTx,
           blockNumber: latestKnownBlock.toString(),
@@ -1112,7 +1113,45 @@ function buildPipelineBot(config: RuntimeConfig, metrics: BotMetrics): BotRunner
           });
           return;
         }
-        await orchestrator.runOnce();
+        // Event-purity owns detection; watchlist full-sweep timer is disabled and
+        // EventDrivenWatchlist is deferred — so stale-critical can fire with a live HF<1.
+        // Refresh + upsert this account into the pipeline cache, mark freshness, then
+        // runOnce with stale-critical bypass for this candidate path only.
+        watchlistCoordinator?.registerBorrowers([candidate.account], latestKnownBlock);
+        let refreshed = 0;
+        if (watchlistCoordinator !== undefined) {
+          try {
+            const snapshots = await watchlistCoordinator.refreshBorrowers(
+              config.chain,
+              [candidate.account],
+            );
+            for (const snapshot of snapshots) {
+              hybridDetection.cache.upsert(snapshot);
+              refreshed += 1;
+            }
+            watchlistCoordinator.markFresh("event_purity_liquidatable_candidate");
+          } catch (error) {
+            logger.warn("liquidatable_candidate_cache_upsert_failed", {
+              chain: config.chain,
+              account: candidate.account,
+              error: error instanceof Error ? error.message : String(error),
+            });
+          }
+        }
+        logger.info("liquidatable_candidate_pipeline_armed", {
+          chain: config.chain,
+          account: candidate.account,
+          cacheUpserts: refreshed,
+          watchlistAgeMs: watchlistCoordinator?.stalenessGuard.ageMs(),
+        });
+        await orchestrator.runOnce({
+          bypassWatchlistStaleCritical: true,
+          bypassReason: "fresh_event_purity_candidate",
+        });
+      },
+      onIngestionHeartbeat: () => {
+        // Keep staleness fresh while Flashblocks ingestion is alive (no poll sweep under purity).
+        watchlistCoordinator?.stalenessGuard.record();
       },
     });
     eventPurityStackRef = eventPurityStack;
