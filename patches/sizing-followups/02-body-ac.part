diff --git a/test/unit/aaveReservePositionsBonus.test.ts b/test/unit/aaveReservePositionsBonus.test.ts
new file mode 100644
index 0000000..77035be
--- /dev/null
+++ b/test/unit/aaveReservePositionsBonus.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it, vi } from "vitest";
+import type { Address } from "viem";
+import { createChainRegistry } from "../../src/config/chainRegistry";
+import { getChainConfig } from "../../src/config/chains";
+import { AaveSnapshotProvider } from "../../src/monitors/aaveSnapshotProvider";
+import { ViemAaveV3Protocol } from "../../src/protocols/aaveV3";
+import {
+  decodeReserveConfiguration,
+  encodeReserveConfiguration,
+  resolveAccountReservePositions,
+} from "../../src/protocols/aaveReservePositions";
+import { FakeAaveReserveClient, RAY, type FakeReserveMarket } from "../helpers/fakeAaveReserveClient";
+
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" as Address;
+const WETH = "0x4200000000000000000000000000000000000006" as Address;
+const CBBTC = "0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf" as Address;
+const USER = "0x00000000000000000000000000000000000000b1" as Address;
+const addresses = {
+  pool: "0x00000000000000000000000000000000000000c1" as Address,
+  poolAddressesProvider: "0x00000000000000000000000000000000000000c2" as Address,
+  uiPoolDataProvider: "0x00000000000000000000000000000000000000c3" as Address,
+};
+const oracle = "0x00000000000000000000000000000000000000fe" as Address;
+
+function markets(overrides: Partial<Record<string, Partial<FakeReserveMarket>>> = {}): Map<string, FakeReserveMarket> {
+  const base: Record<string, FakeReserveMarket> = {
+    [USDC.toLowerCase()]: { liquidityIndex: RAY, variableBorrowIndex: RAY, priceUsd8: 100_000_000n, decimals: 6 },
+    [WETH.toLowerCase()]: { liquidityIndex: RAY, variableBorrowIndex: RAY, priceUsd8: 300_000_000_000n, decimals: 18 },
+    [CBBTC.toLowerCase()]: { liquidityIndex: RAY, variableBorrowIndex: RAY, priceUsd8: 8_000_000_000_000n, decimals: 8 },
+  };
+  return new Map(Object.entries(base).map(([key, value]) => [key, { ...value, ...(overrides[key] ?? {}) }]));
+}
+
+const cbBtcCollateralUsdcDebt = [
+  { underlyingAsset: USDC, scaledATokenBalance: 0n, usageAsCollateralEnabledOnUser: false, scaledVariableDebt: 10_000_000_000n },
+  { underlyingAsset: CBBTC, scaledATokenBalance: 20_000_000n, usageAsCollateralEnabledOnUser: true, scaledVariableDebt: 0n },
+];
+
+async function resolve(fake: FakeAaveReserveClient) {
+  const result = await resolveAccountReservePositions({
+    client: fake, addresses, oracle, accounts: [USER], assets: [USDC, WETH, CBBTC],
+  });
+  return result.get(USER.toLowerCase())!;
+}
+
+describe("on-chain liquidation bonus (eMode-aware)", () => {
+  it("decodes Base reserve configuration words (archive @ 51765799)", () => {
+    const cbBtc = decodeReserveConfiguration(0x100000000000000000000003e8000000c8000000017c1388850829fe1e781c84n);
+    expect(cbBtc.liquidationBonusRaw).toBe(10_750);
+    expect(cbBtc.liquidationThresholdBps).toBe(7_800);
+    expect(cbBtc.ltvBps).toBe(7_300);
+    expect(cbBtc.decimals).toBe(8);
+    expect(cbBtc.liquidationProtocolFeeBps).toBe(1_000);
+    expect(cbBtc.borrowingEnabled).toBe(true);
+    const weth = decodeReserveConfiguration(0x100000000000000000000103e800001e8480000186a005dc85122904206c1f40n);
+    expect(weth.liquidationBonusRaw).toBe(10_500);
+    expect(weth.liquidationThresholdBps).toBe(8_300);
+    expect(decodeReserveConfiguration(encodeReserveConfiguration({ liquidationBonusRaw: 10_400, decimals: 6 })).liquidationBonusRaw).toBe(10_400);
+  });
+
+  it("non-eMode account: reserve bonus from getConfiguration (cbBTC 750)", async () => {
+    const fake = new FakeAaveReserveClient(markets(), new Map([[USER.toLowerCase(), cbBtcCollateralUsdcDebt]]));
+    const row = await resolve(fake);
+    if (!row.ok) throw new Error(row.error);
+    const cbBtc = row.positions.reserves.find((reserve) => reserve.asset === CBBTC)!;
+    expect(cbBtc.liquidationBonusBps).toBe(750);
+    expect(cbBtc.liquidationProtocolFeeBps).toBe(1_000);
+    expect(cbBtc.liquidationBonusSource).toBe("reserve");
+    expect(row.positions.eModeCategoryId).toBe(0);
+  });
+
+  it("eMode 10 (cbBTC Stablecoins) account: eMode bonus 400 applies to cbBTC collateral (id 6 in bitmap)", async () => {
+    const fake = new FakeAaveReserveClient(markets(), new Map([[USER.toLowerCase(), cbBtcCollateralUsdcDebt]]));
+    fake.userEMode.set(USER.toLowerCase(), 10);
+    fake.eModeCategories.set(10, { liquidationBonusRaw: 10_400, collateralBitmap: 1n << 6n });
+    const row = await resolve(fake);
+    if (!row.ok) throw new Error(row.error);
+    const cbBtc = row.positions.reserves.find((reserve) => reserve.asset === CBBTC)!;
+    expect(cbBtc.liquidationBonusBps).toBe(400);
+    expect(cbBtc.liquidationBonusSource).toBe("emode:10");
+    expect(row.positions.eModeCategoryId).toBe(10);
+  });
+
+  it("eMode account whose collateral is NOT in the category bitmap keeps the reserve bonus", async () => {
+    const fake = new FakeAaveReserveClient(markets(), new Map([[USER.toLowerCase(), cbBtcCollateralUsdcDebt]]));
+    fake.userEMode.set(USER.toLowerCase(), 1);
+    fake.eModeCategories.set(1, { liquidationBonusRaw: 10_200, collateralBitmap: 0b101011n }); // WETH (id 0) etc, not cbBTC
+    const row = await resolve(fake);
+    if (!row.ok) throw new Error(row.error);
+    expect(row.positions.reserves.find((reserve) => reserve.asset === CBBTC)!.liquidationBonusBps).toBe(750);
+  });
+
+  it("eMode config read failure fails the account closed", async () => {
+    const fake = new FakeAaveReserveClient(markets(), new Map([[USER.toLowerCase(), cbBtcCollateralUsdcDebt]]));
+    fake.userEMode.set(USER.toLowerCase(), 10);
+    fake.eModeCategories.set(10, { liquidationBonusRaw: 10_400, collateralBitmap: 1n << 6n, fails: true });
+    const row = await resolve(fake);
+    expect(row.ok).toBe(false);
+    if (!row.ok) expect(row.error).toBe("emode_config_failed:10");
+  });
+
+  it("getConfiguration failure => bonus undefined => snapshot provider logs liquidation_bonus_unavailable_skip (no config fallback)", async () => {
+    const fake = new FakeAaveReserveClient(
+      markets({ [CBBTC.toLowerCase()]: { configurationFails: true } }),
+      new Map([[USER.toLowerCase(), cbBtcCollateralUsdcDebt]]),
+    );
+    const registry = createChainRegistry({
+      chains: [{ chain: "base", rpcUrl: "https://base.example", fallbackRpcUrls: [], aaveSubgraphUrl: "https://subgraph.example" }],
+    });
+    const accountData = [16_000n * 100_000_000n, 10_000n * 100_000_000n, 0n, 7_800n, 7_300n, 990_000_000_000_000_000n] as const;
+    const protocol = new ViemAaveV3Protocol(
+      { readContract: async () => accountData, multicall: fake.multicall.bind(fake) } as never,
+      getChainConfig("base"), undefined, undefined, 50, registry,
+    );
+    const log = { info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+    const provider = new AaveSnapshotProvider("base", protocol, registry, log);
+    expect(await provider.refreshBorrowers("base", [USER])).toHaveLength(0);
+    const skip = log.warn.mock.calls.find((call) => call[0] === "liquidation_bonus_unavailable_skip")?.[1] as Record<string, unknown>;
+    expect(skip).toBeDefined();
+    expect(skip.collateralAsset).toBe(CBBTC);
+    expect(skip.action).toBe("skip_candidate");
+  });
+});
diff --git a/test/unit/baseReservePairs.test.ts b/test/unit/baseReservePairs.test.ts
new file mode 100644
index 0000000..bc7ca78
--- /dev/null
+++ b/test/unit/baseReservePairs.test.ts
@@ -0,0 +1,43 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { getChainConfig } from "../../src/config/chains";
+
+const params = JSON.parse(readFileSync(join(__dirname, "../fixtures/base-aave-reserve-params-2026-09-28.json"), "utf8")) as {
+  assets: Record<string, { address: string; liquidationBonusRaw: number; borrowingEnabled: boolean; canBeCollateral: boolean; liquidationThresholdBps: number }>;
+};
+const symbolOf = (address: string): string => Object.entries(params.assets)
+  .find(([, row]) => row.address.toLowerCase() === address.toLowerCase())![0];
+
+describe("Base reserve pairs (WETH/USDC/cbBTC permutations)", () => {
+  const pairs = getChainConfig("base").aave.reservePairs;
+
+  it("covers all 6 collateral/debt permutations of WETH, USDC, cbBTC; WETH/USDC stays first (legacy placeholder)", () => {
+    const keys = pairs.map((pair) => `${symbolOf(pair.collateralAsset)}/${symbolOf(pair.debtAsset)}`);
+    expect(keys[0]).toBe("WETH/USDC");
+    expect(new Set(keys)).toEqual(new Set(["WETH/USDC", "cbBTC/USDC", "USDC/WETH", "cbBTC/WETH", "WETH/cbBTC", "USDC/cbBTC"]));
+  });
+
+  it("every pair is allowed by Aave Base (collateral LT>0 + canBeCollateral, debt borrowable)", () => {
+    for (const pair of pairs) {
+      const collateral = params.assets[symbolOf(pair.collateralAsset)]!;
+      const debt = params.assets[symbolOf(pair.debtAsset)]!;
+      expect(collateral.canBeCollateral).toBe(true);
+      expect(collateral.liquidationThresholdBps).toBeGreaterThan(0);
+      expect(debt.borrowingEnabled).toBe(true);
+    }
+  });
+
+  it("config bonus (reference only) equals the collateral reserve's on-chain non-eMode bonus", () => {
+    for (const pair of pairs) {
+      expect(pair.liquidationBonusBps).toBe(params.assets[symbolOf(pair.collateralAsset)]!.liquidationBonusRaw - 10_000);
+    }
+  });
+
+  it("legacy defaultDebtToCoverWei is ~$1 of the debt asset (never used for sizing)", () => {
+    const expected: Record<string, bigint> = { USDC: 1_000_000n, WETH: 400_000_000_000_000n, cbBTC: 1_200n };
+    for (const pair of pairs) {
+      expect(pair.defaultDebtToCoverWei).toBe(expected[symbolOf(pair.debtAsset)]);
+    }
+  });
+});
