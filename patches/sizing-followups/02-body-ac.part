oCover) {
+      // Protocol caps by collateral itself; submitting the full liquidatable amount guarantees ALL collateral is
+      // taken (no dust). A floor-rounded collateral cap would leave wei-level collateral -> MustNotLeaveDust.
+      cappedBy = "collateral";
+      noDustAdjustment = "bumped_to_full_debt";
+    }
+    if (dust(simulation)) {
+      // Only reachable with the 50% cap (both reserves >= $2k, HF > 0.95). With R >= $2k, R - 50%*T >= R/2 >= $1k,
+      // so it is the COLLATERAL leftover that would be dust: shrink debtToCover so >= MIN_LEFTOVER_BASE of both
+      // collateral and debt remain (smaller but valid liquidation).
+      const collateralUnit = 10n ** BigInt(collateral.decimals);
+      const collateralLeftRaw = ceilDiv(MIN_LEFTOVER_BASE * collateralUnit, collateral.priceUsd8) + 1n;
+      const debtLeftRaw = ceilDiv(MIN_LEFTOVER_BASE * debtUnit, debt.priceUsd8) + 1n;
+      const maxSeize = collateral.collateralBalance - collateralLeftRaw;
+      const byCollateral = maxSeize > 0n
+        ? (maxSeize * collateral.priceUsd8 * debtUnit * bps)
+          / (collateralUnit * debt.priceUsd8 * (bps + BigInt(liquidationBonusBps))) - 1n
+        : 0n;
+      const byDebt = actualDebtRaw - debtLeftRaw;
+      let reduced = maxLiquidatable;
+      if (byCollateral < reduced) {
+        reduced = byCollateral;
+      }
+      if (byDebt < reduced) {
+        reduced = byDebt;
+      }
+      const reducedSimulation = reduced > 0n ? simulate(reduced) : undefined;
+      if (reducedSimulation === undefined || dust(reducedSimulation)) {
+        return {
+          kind: "must_not_leave_dust",
+          collateralAsset: collateral.asset,
+          debtAsset: debt.asset,
+          actualDebtUsd: usd8ToNumber(reserveDebtBase),
+          collateralUsd: usd8ToNumber(reserveCollateralBase),
+          closeFactorBps,
+        };
+      }
+      debtToCover = reduced;
+      simulation = reducedSimulation;
+      noDustAdjustment = "reduced_to_min_leftover";
+    }
   }
 
   return {
-    collateralAsset: collateral.asset,
-    debtAsset: debt.asset,
-    debtDecimals: debt.decimals,
-    collateralDecimals: collateral.decimals,
-    debtPriceUsd8: debt.priceUsd8,
-    collateralPriceUsd8: collateral.priceUsd8,
-    debtToCover,
-    debtToCoverUsd: usd8ToNumber(reserveUsd8(debtToCover, debt.decimals, debt.priceUsd8)),
-    actualDebtRaw,
-    actualDebtUsd: usd8ToNumber(reserveDebtBase),
-    collateralBalanceRaw: collateral.collateralBalance,
-    collateralUsd: usd8ToNumber(reserveCollateralBase),
-    ...(input.totalDebtBase === undefined ? {} : { totalDebtUsd: usd8ToNumber(input.totalDebtBase) }),
-    closeFactorBps,
-    liquidationBonusBps: pair.liquidationBonusBps,
-    cappedBy,
+    kind: "planned",
+    plan: {
+      collateralAsset: collateral.asset,
+      debtAsset: debt.asset,
+      debtDecimals: debt.decimals,
+      collateralDecimals: collateral.decimals,
+      debtPriceUsd8: debt.priceUsd8,
+      collateralPriceUsd8: collateral.priceUsd8,
+      debtToCover,
+      debtToCoverUsd: usd8ToNumber(reserveUsd8(debtToCover, debt.decimals, debt.priceUsd8)),
+      expectedDebtRepaidRaw: simulation.debtRepaid,
+      expectedDebtRepaidUsd: usd8ToNumber(reserveUsd8(simulation.debtRepaid, debt.decimals, debt.priceUsd8)),
+      expectedCollateralOutRaw: simulation.liquidatorCollateral,
+      expectedProtocolFeeRaw: simulation.protocolFee,
+      actualDebtRaw,
+      actualDebtUsd: usd8ToNumber(reserveDebtBase),
+      collateralBalanceRaw: collateral.collateralBalance,
+      collateralUsd: usd8ToNumber(reserveCollateralBase),
+      ...(input.totalDebtBase === undefined ? {} : { totalDebtUsd: usd8ToNumber(input.totalDebtBase) }),
+      closeFactorBps,
+      liquidationBonusBps,
+      liquidationProtocolFeeBps,
+      cappedBy,
+      v33Rules,
+      noDustAdjustment,
+    },
   };
 }
 
