current !== undefined && current !== null; depth += 1) {
+    const candidate = (current as { data?: unknown }).data;
+    if (typeof candidate === "string" && candidate.startsWith("0x")) {
+      return candidate;
+    }
+    if (typeof candidate === "object" && candidate !== null && typeof (candidate as { data?: unknown }).data === "string") {
+      return (candidate as { data: string }).data;
+    }
+    current = (current as { cause?: unknown }).cause;
+  }
+  return undefined;
+}
+
+function isExecutionRevert(error: unknown): boolean {
+  let current: unknown = error;
+  for (let depth = 0; depth < 8 && current !== undefined && current !== null; depth += 1) {
+    const text = `${(current as { name?: string }).name ?? ""} ${(current as { message?: string }).message ?? ""} ${(current as { details?: string }).details ?? ""}`;
+    if (/execution reverted|ExecutionRevertedError|ContractFunctionRevertedError/i.test(text)) {
+      return true;
+    }
+    current = (current as { cause?: unknown }).cause;
+  }
+  return false;
+}
+
+function firstLine(error: unknown): string {
+  const message = error instanceof Error ? error.message : String(error);
+  return message.split("\n")[0] ?? message;
 }
