+/**
+ * LiquidationLogic v3.3+: eMode bonus iff borrower eMode != 0 AND collateral reserve id is in the category
+ * collateral bitmap; otherwise the reserve bonus. Returns {} (bonus unknown -> sizing fails closed) when inputs
+ * are missing or the bonus is <= 100%.
+ */
+function effectiveBonus(
+  data: AssetMarketData,
+  eModeCategoryId: number,
+  eMode: EModeCategoryData | undefined,
+  reserveId: number | undefined,
