+
+export interface DecodedReserveConfiguration {
+  readonly ltvBps: number;
+  readonly liquidationThresholdBps: number;
+  /** Raw Aave value, e.g. 10500 = 105%. */
+  readonly liquidationBonusRaw: number;
+  readonly decimals: number;
+  readonly active: boolean;
+  readonly frozen: boolean;
+  readonly borrowingEnabled: boolean;
+  readonly paused: boolean;
+  readonly liquidationProtocolFeeBps: number;
+}
+
+function bits(value: bigint, start: number, width: number): number {
+  return Number((value >> BigInt(start)) & ((1n << BigInt(width)) - 1n));
+}
+
+/** ReserveConfiguration bit layout (aave-v3-origin ReserveConfiguration.sol). */
+export function decodeReserveConfiguration(data: bigint): DecodedReserveConfiguration {
+  return {
+    ltvBps: bits(data, 0, 16),
+    liquidationThresholdBps: bits(data, 16, 16),
+    liquidationBonusRaw: bits(data, 32, 16),
+    decimals: bits(data, 48, 8),
+    active: bits(data, 56, 1) === 1,
+    frozen: bits(data, 57, 1) === 1,
+    borrowingEnabled: bits(data, 58, 1) === 1,
+    paused: bits(data, 60, 1) === 1,
+    liquidationProtocolFeeBps: bits(data, 152, 16),
+  };
+}
+
+/** Encode (for tests / fixtures) the subset of ReserveConfiguration fields sizing reads. */
+export function encodeReserveConfiguration(input: {
+  readonly ltvBps?: number;
+  readonly liquidationThresholdBps?: number;
+  readonly liquidationBonusRaw: number;
+  readonly decimals: number;
+  readonly liquidationProtocolFeeBps?: number;
+  readonly borrowingEnabled?: boolean;
+}): bigint {
+  return BigInt(input.ltvBps ?? 0)
+    | (BigInt(input.liquidationThresholdBps ?? 0) << 16n)
+    | (BigInt(input.liquidationBonusRaw) << 32n)
+    | (BigInt(input.decimals) << 48n)
+    | (1n << 56n)
+    | ((input.borrowingEnabled ?? true) ? 1n << 58n : 0n)
+    | (BigInt(input.liquidationProtocolFeeBps ?? 0) << 152n);
+}
