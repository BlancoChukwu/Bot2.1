+    return {};
+  }
+  let raw = data.configuration.liquidationBonusRaw;
+  let source = "reserve";
+  if (eModeCategoryId !== 0) {
+    if (eMode === undefined || reserveId === undefined) {
+      return {};
+    }
+    if (((eMode.collateralBitmap >> BigInt(reserveId)) & 1n) === 1n) {
+      raw = eMode.liquidationBonusRaw;
+      source = `emode:${eModeCategoryId}`;
+    }
+  }
+  if (raw <= 10_000) {
+    return {};
+  }
+  return {
+    liquidationBonusBps: raw - 10_000,
+    liquidationProtocolFeeBps: data.configuration.liquidationProtocolFeeBps,
+    liquidationBonusSource: source,
+  };
+}
