diff --git a/src/config/aavePoolVersion.ts b/src/config/aavePoolVersion.ts
index 2a0d8d1..1810daa 100644
--- a/src/config/aavePoolVersion.ts
+++ b/src/config/aavePoolVersion.ts
@@ -5,10 +5,27 @@ export function resolveAavePoolVersion(): AavePoolVersion {
   return raw === "v4" ? "v4" : "v3";
 }
 
-/** v3: protocol caps at 50% unless HF < 0.95 (then 100%). v4: target HF repayment — not yet wired. */
+/**
+ * Legacy (pre-v3.3) close factor: 50% unless HF < 0.95 (then 100%). v4: target HF repayment — not yet wired.
+ * Aave v3.3+ sizing (small-position 100% close + MustNotLeaveDust) lives in `protocols/liquidationSizing.ts`.
+ */
 export function defaultCloseFactorBps(poolVersion: AavePoolVersion, healthFactorWad: bigint): number {
   if (poolVersion === "v4") {
     return 10_000;
   }
   return healthFactorWad < 950_000_000_000_000_000n ? 10_000 : 5_000;
 }
+
+/**
+ * Aave v3.3+ LiquidationLogic rules (100% close factor for positions whose chosen collateral OR debt reserve is
+ * < $2,000 base, HF <= 0.95 inclusive, and the MustNotLeaveDust leftover rule). Base Pool
+ * 0xA238Dd80C259a72e81d7e4664a9801593F98d1c5 reports POOL_REVISION 11 (verified 2026-09-28 via public RPC).
+ * Default ON. Disable with AAVE_V33_LIQUIDATION_RULES=false|0|off|no (legacy 50/100 at HF<0.95 only).
+ */
+export function resolveAaveV33LiquidationRules(env: Record<string, string | undefined> = process.env): boolean {
+  const raw = env.AAVE_V33_LIQUIDATION_RULES;
+  if (raw === undefined || raw.trim() === "") {
+    return true;
+  }
+  return !["false", "0", "off", "no"].includes(raw.trim().toLowerCase());
+}
