-export function estimateMinimumCollateralOut(candidate: LiquidationCandidate, slippageBps: number): bigint {
-  const poolVersion = resolveAavePoolVersion();
-  const effectiveCloseFactorBps = candidate.closeFactorBps
-    ?? defaultCloseFactorBps(poolVersion, candidate.healthFactor);
+/**
+ * Expected minimum COLLATERAL (native collateral-token units) the liquidator receives, after the Aave liquidation
+ * protocol fee and a slippage haircut.
+ *
+ * Bug fixed (pre-fix implementation): it returned `debtToCover * closeFactor * (1 + bonus) * (1 - slippage)` —
+ * a number in DEBT-token raw units — and labelled it collateral. With USDC (6 dec) debt / WETH (18 dec) collateral
+ * $1,000 of debt produced 997_500_000 "wei" = 1e-9 WETH (a vacuous floor); with WETH debt / USDC collateral 1 WETH
+ * produced 9.975e17 USDC units (~$1e12, unreachable). It also ignored the debt/collateral price ratio and the
+ * liquidation protocol fee. Now: Aave's own formula
+ *   base = debtRepaid * debtPrice * 10^collDec / (collPrice * 10^debtDec); gross = percentMul(base, 1e4 + bonus)
+ *   (capped at the borrower's collateral balance), minus protocol fee on the bonus portion, minus slippage.
+ * Returns undefined (fail closed — never a wrong-unit number) when prices/decimals are not on the candidate.
+ * Not sent on-chain by the v1 receiver route (no such field); used for dry-run / diagnostics.
+ */
+export function estimateMinimumCollateralOut(candidate: LiquidationCandidate, slippageBps: number): bigint | undefined {
+  if (
+    candidate.debtPriceUsd8 === undefined || candidate.collateralPriceUsd8 === undefined
+    || candidate.debtDecimals === undefined || candidate.collateralDecimals === undefined
+    || candidate.debtPriceUsd8 <= 0n || candidate.collateralPriceUsd8 <= 0n
+  ) {
+    return undefined;
+  }
+  // Planner-sized candidates already respect the protocol close factor; only legacy candidates get it applied.
+  const effectiveCloseFactorBps = candidate.appliedCloseFactorBps !== undefined
+    ? 10_000
+    : candidate.closeFactorBps ?? defaultCloseFactorBps(resolveAavePoolVersion(), candidate.healthFactor);
+  const debtRepaid = candidate.expectedDebtRepaidRaw
+    ?? (candidate.debtToCover * BigInt(effectiveCloseFactorBps)) / 10_000n;
   const bonusBps = candidate.effectiveLiquidationBonusBps ?? candidate.liquidationBonusBps;
-  const debtCovered = (candidate.debtToCover * BigInt(effectiveCloseFactorBps)) / 10_000n;
-  const grossCollateral = debtCovered + (debtCovered * BigInt(bonusBps)) / 10_000n;
-  const haircut = (grossCollateral * BigInt(slippageBps)) / 10_000n;
-  return grossCollateral > haircut ? grossCollateral - haircut : 0n;
+  const simulation = simulateCollateralToLiquidate({
+    debtToCover: debtRepaid,
+    debtPriceUsd8: candidate.debtPriceUsd8,
+    debtDecimals: candidate.debtDecimals,
+    collateralPriceUsd8: candidate.collateralPriceUsd8,
+    collateralDecimals: candidate.collateralDecimals,
+    collateralBalance: candidate.collateralBalanceRaw ?? (1n << 255n),
+    liquidationBonusBps: bonusBps,
+    // Unknown fee => assume the worst case (protocol keeps the whole bonus portion).
+    liquidationProtocolFeeBps: candidate.liquidationProtocolFeeBps ?? 10_000,
+  });
+  const gross = simulation.liquidatorCollateral;
+  const haircut = (gross * BigInt(slippageBps)) / 10_000n;
+  return gross > haircut ? gross - haircut : 0n;
 }
 
 function usdRaw(value: number): ReturnType<typeof createAssetAmount> {
