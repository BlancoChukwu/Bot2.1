+++ b/test/unit/phase2RealSizing.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it, vi } from "vitest";
+import type { Address } from "viem";
+import { fetchLiquidationCandidates } from "../../src/backtesting/phase2TargetedDryRun";
+import { createChainRegistry } from "../../src/config/chainRegistry";
+import { getChainConfig } from "../../src/config/chains";
+import { AaveSnapshotProvider } from "../../src/monitors/aaveSnapshotProvider";
+import { ViemAaveV3Protocol } from "../../src/protocols/aaveV3";
+import { FakeAaveReserveClient, RAY } from "../helpers/fakeAaveReserveClient";
+
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" as Address;
+const WETH = "0x4200000000000000000000000000000000000006" as Address;
+const CBBTC = "0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf" as Address;
+const DUST = "0x00000000000000000000000000000000000000d1" as Address;
+const HEALTHY = "0x00000000000000000000000000000000000000d2" as Address;
+
+describe("phase-2 dry-run uses real sizing (planAaveLiquidation), not getBestLiquidationPair/default sizing", () => {
+  it("sizes a dust cbBTC-debt account from real reserves and skips healthy accounts", async () => {
+    const markets = new Map([
+      [USDC.toLowerCase(), { liquidityIndex: RAY, variableBorrowIndex: RAY, priceUsd8: 100_000_000n, decimals: 6 }],
+      [WETH.toLowerCase(), { liquidityIndex: RAY, variableBorrowIndex: RAY, priceUsd8: 300_000_000_000n, decimals: 18 }],
+      [CBBTC.toLowerCase(), { liquidityIndex: RAY, variableBorrowIndex: RAY, priceUsd8: 8_000_000_000_000n, decimals: 8 }],
+    ]);
+    const fake = new FakeAaveReserveClient(markets, new Map([[DUST.toLowerCase(), [
+      { underlyingAsset: CBBTC, scaledATokenBalance: 0n, usageAsCollateralEnabledOnUser: false, scaledVariableDebt: 11n },
+      { underlyingAsset: USDC, scaledATokenBalance: 12_000n, usageAsCollateralEnabledOnUser: true, scaledVariableDebt: 0n },
+    ]]]));
+    const accountData = new Map<string, readonly bigint[]>([
+      [DUST.toLowerCase(), [1_200_000n, 880_000n, 0n, 7_800n, 7_500n, 990_000_000_000_000_000n]],
+      [HEALTHY.toLowerCase(), [10n ** 12n, 10n ** 10n, 0n, 7_800n, 7_500n, 5n * 10n ** 18n]],
+    ]);
+    const registry = createChainRegistry({
+      chains: [{ chain: "base", rpcUrl: "https://base.example", fallbackRpcUrls: [], aaveSubgraphUrl: "https://subgraph.example" }],
+    });
+    const protocol = new ViemAaveV3Protocol(
+      {
+        readContract: async (parameters: { readonly args: readonly [Address] }) => accountData.get(parameters.args[0].toLowerCase()),
+        multicall: fake.multicall.bind(fake),
+      } as never,
+      getChainConfig("base"), undefined, undefined, 50, registry,
+    );
+    const getBestLiquidationPair = vi.spyOn(protocol, "getBestLiquidationPair");
+    const log = { info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+    const { candidates, skippedHealthy } = await fetchLiquidationCandidates(
+      protocol, [DUST, HEALTHY], log, new AaveSnapshotProvider("base", protocol, registry, log), "base", 100,
+    );
+    expect(getBestLiquidationPair).not.toHaveBeenCalled();
+    expect(skippedHealthy).toBe(1);
+    expect(candidates).toHaveLength(1);
+    expect(candidates[0]!.debtAsset).toBe(CBBTC);
+    expect(candidates[0]!.collateralAsset).toBe(USDC);
+    expect(candidates[0]!.debtToCover).toBe(11n);
+    expect(candidates[0]!.appliedCloseFactorBps).toBe(10_000);
+    const sized = log.info.mock.calls.find((call) => call[0] === "phase2_real_sizing")?.[1] as Record<string, unknown>;
+    expect(sized.debtToCover).toBe("11");
+    expect(sized.expectedMinCollateralOut).not.toBeNull();
+  });
+});
diff --git a/test/unit/receiverLayoutMismatch.test.ts b/test/unit/receiverLayoutMismatch.test.ts
new file mode 100644
index 0000000..07678ce
--- /dev/null
+++ b/test/unit/receiverLayoutMismatch.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { decodeAbiParameters, encodeAbiParameters, parseAbiParameters, type Address } from "viem";
+import {
+  decodeLiquidationRouteV1,
+  encodeLiquidationRoute,
+  encodeMoonwellRoute,
+  MULTI_PROTOCOL_RECEIVER_PARAMS,
+} from "../../src/protocols/liquidationFlashLoanReceiver";
+
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" as Address;
+const WETH = "0x4200000000000000000000000000000000000006" as Address;
+const USER = "0xf20e421cf0b314d61177466d3c9c0cb5e1342ecb" as Address;
+/** Exactly what the live v1 receiver does: abi.decode(params,(address,address,address,uint256,bool)). */
+const v1DecodeLayout = parseAbiParameters("address,address,address,uint256,bool");
+
+describe("receiver calldata layout (live v1 @ 0x379c…ada6)", () => {
+  it("RECREATES today's bug: the 8cbab38 7-field payload decoded with the v1 layout => DebtAssetMismatch", () => {
+    // (a) realistic debtToCover: v1 reads word 4 (the 7-field debtToCover) as `bool receiveAToken`; 4619 is not 0/1 =>
+    // Solidity abi.decode reverts with EMPTY data (viem's strict decoder rejects it the same way).
+    const realistic = encodeAbiParameters(parseAbiParameters(MULTI_PROTOCOL_RECEIVER_PARAMS), [
+      0, WETH, USDC, USER, 4_619n, 1n, false,
+    ]);
+    expect(() => decodeAbiParameters(v1DecodeLayout, realistic)).toThrow(/boolean/);
+    // (b) debtToCover=1 makes the bool word valid => decode "succeeds" with shifted fields => DebtAssetMismatch.
+    const sevenField = encodeAbiParameters(parseAbiParameters(MULTI_PROTOCOL_RECEIVER_PARAMS), [
+      0, WETH, USDC, USER, 1n, 1n, false,
+    ]);
+    const [collateral, debt] = decodeAbiParameters(v1DecodeLayout, sevenField);
+    expect(collateral).toBe("0x0000000000000000000000000000000000000000"); // routeType word
+    expect(debt.toLowerCase()).toBe(WETH.toLowerCase()); // collateral word lands in debtAsset
+    // v1: `if (debtAsset != asset) revert DebtAssetMismatch();` with asset = flash-borrowed USDC
+    expect(debt.toLowerCase()).not.toBe(USDC.toLowerCase());
+    // Same shape as the isolated Moonwell encoder: never used for the Aave route.
+    expect((encodeMoonwellRoute({ collateralAsset: WETH, debtAsset: USDC, user: USER, debtToCover: 1n, minCollateralOut: 1n }).length - 2) / 64).toBe(7);
+  });
+
+  it("FIX: encodeLiquidationRoute emits the v1 5-field layout and round-trips through the v1 decoder", () => {
+    const encoded = encodeLiquidationRoute({ collateralAsset: WETH, debtAsset: USDC, user: USER, debtToCover: 4_619n });
+    expect((encoded.length - 2) / 64).toBe(5);
+    const [collateral, debt, user, debtToCover, receiveAToken] = decodeAbiParameters(v1DecodeLayout, encoded);
+    expect(collateral).toBe(WETH);
+    expect(debt).toBe(USDC);
+    expect(user.toLowerCase()).toBe(USER);
+    expect(debtToCover).toBe(4_619n);
+    expect(receiveAToken).toBe(false);
+    expect(decodeLiquidationRouteV1(encoded).debtAsset).toBe(USDC);
+    // Byte-exact vs the 042e442 encoder layout.
+    expect(encoded).toBe(encodeAbiParameters(
+      parseAbiParameters("address collateralAsset,address debtAsset,address user,uint256 debtToCover,bool receiveAToken"),
+      [WETH, USDC, USER, 4_619n, false],
+    ));
+  });
+});
