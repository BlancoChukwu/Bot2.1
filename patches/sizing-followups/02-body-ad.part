+describe("simulateCollateralToLiquidate", () => {
+  it("matches Aave PercentageMath (bonus + protocol fee)", () => {
+    // $1000 USDC debt, $1 WETH collateral price, 5% bonus, 10% protocol fee of bonus.
+    const sim = simulateCollateralToLiquidate({
+      debtToCover: 1_000_000_000n,
+      debtPriceUsd8: USDC_PRICE,
+      debtDecimals: 6,
+      collateralPriceUsd8: WETH_PRICE,
+      collateralDecimals: 18,
+      collateralBalance: 10n ** 18n,
+      liquidationBonusBps: 500,
+      liquidationProtocolFeeBps: 1_000,
+    });
+    // base = 1000/3000 WETH = 1/3e18; *1.05 = 0.35e18.
+    expect(sim.collateralSeized).toBe(350_000_000_000_000_000n);
+    // bonus portion = 0.35e18 - percentDiv(0.35e18, 10500) = 0.35e18 - 333_333_333_333_333_333 = 16_666_666_666_666_667
+    // fee = percentMul(that, 1000) = 1_666_666_666_666_667
+    expect(sim.protocolFee).toBe(1_666_666_666_666_667n);
+    expect(sim.liquidatorCollateral).toBe(sim.collateralSeized - sim.protocolFee);
+    expect(sim.debtRepaid).toBe(1_000_000_000n);
+  });
+});
