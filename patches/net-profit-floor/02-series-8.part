+describe("computeFloorShadow / FloorShadowCounters", () => {
+  it("flags each floor independently and counts them", () => {
+    const counters = new FloorShadowCounters();
+    // net of the base case at various sizes
+    const eval_ = (debtUsd: number, gas = 0.1) => evaluateLiquidationProfitability({ ...base, debtUsd, gasCostUsd: gas });
+    const tiny = eval_(3, 0.05);      // net << 0.25
+    const mid = eval_(40);            // sub-$50 debt
+    const big = eval_(5_000);         // clearly > $5
+    const s1 = computeFloorShadow(tiny, 3, true);
+    const s2 = computeFloorShadow(mid, 40, true);
+    const s3 = computeFloorShadow(big, 5_000, true);
+    expect(s1).toMatchObject({ net025: false, net1: false, net5: false, debt50: false });
+    expect(s2.debt50).toBe(false);
+    expect(s3).toMatchObject({ net025: true, net1: true, net5: true, debt50: true, live: true });
+    [s1, s2, s3].forEach((s) => counters.record(s));
+    expect(counters.snapshot().total).toBe(3);
+    expect(counters.snapshot().debt50).toBe(1);
+  });
+
+  it("untrusted debt or missing inputs => every net flag false (no silent pass)", () => {
+    const r = evaluateLiquidationProfitability(base);
+    const untrusted = computeFloorShadow(r, 1_000, false);
+    expect(untrusted).toMatchObject({ net025: false, net1: false, net5: false, debt50: false, live: false, inputsOk: false });
+    const missing = computeFloorShadow(evaluateLiquidationProfitability({ ...base, gasCostUsd: undefined }), 1_000, true);
+    expect(missing).toMatchObject({ net025: false, net1: false, net5: false, inputsOk: false, live: false });
   });
 });
