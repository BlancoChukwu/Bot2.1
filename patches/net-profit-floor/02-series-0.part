+  const sharedNonceManager = new LocalNonceManager();
   const executor = new SafeTransactionExecutor({
     registry,
     router,
-    nonceManager: new LocalNonceManager(),
+    nonceManager: sharedNonceManager,
     client: executionPreflightClient,
     logger,
     metrics,
@@ -1363,6 +1365,13 @@ function buildPipelineBot(config: RuntimeConfig, metrics: BotMetrics): BotRunner
         "LIQUIDATION_RECEIVER_READINESS_BLOCKED: VALIDATE_LIQUIDATION_RECEIVER_RPC=false is not allowed in LIVE (receiver identity/layout must be verified)",
       );
     }
+    if (receiverSweeper !== undefined && !config.simulationMode && config.eventPurity.enableLiveTx) {
+      // eth_call rescue(token, executor, 0) FROM the executor: proves onlyOwner authorization; failure => loud error + sweeps disabled.
+      await receiverSweeper.verifyAuthorization(canonicalBaseUsdc);
+    }
+    if (receiverSweeper !== undefined) {
+      receiverSweeper.startPeriodic(receiverSweepIntervalMs);
+    }
     if (validateLiquidationReceiverRpc) {
       const registryUniswap = getDexesForChain(config.chain).find((dex) => dex.name === "UniswapV3");
       const expectedSwapRouter = liquidationReceiverExpectedSwapRouter ?? registryUniswap?.router;
@@ -1449,12 +1458,47 @@ function buildPipelineBot(config: RuntimeConfig, metrics: BotMetrics): BotRunner
     threshold: parseMinNumber(process.env.EXECUTION_SIM_FAILURE_THRESHOLD, 3, 1, "EXECUTION_SIM_FAILURE_THRESHOLD"),
     openMs: parseMinNumber(process.env.EXECUTION_CIRCUIT_OPEN_MS, 60_000, 1_000, "EXECUTION_CIRCUIT_OPEN_MS"),
   });
+  // Post-fill + periodic receiver sweep. Destination is hard-wired to `account.address` inside ReceiverSweeper
+  // (no env/config override exists); RECEIVER_SWEEP_INTERVAL_MS only tunes the loop cadence.
+  const receiverSweeper = liquidationReceiver === undefined
+    ? undefined
+    : new ReceiverSweeper({
+      chain: config.chain,
+      receiver: liquidationReceiver,
+      signer: account,
+      publicClient: publicClient as never,
+      walletClient: walletClient as never,
+      nonceManager: sharedNonceManager,
+      logger,
+      live: !config.simulationMode && config.eventPurity.enableLiveTx,
+      tokens: () => [
+        ...(config.chain === "base" ? [canonicalBaseWeth, canonicalBaseUsdc, canonicalBaseCbBtc] : []),
+        ...activeChainConfig.aave.reservePairs.flatMap((pair) => [pair.collateralAsset, pair.debtAsset]),
+      ],
+      alert: (event, payload) => webhookAlerter.notify(event, payload),
+    });
+  const receiverSweepIntervalMs = parseMinNumber(
+    process.env.RECEIVER_SWEEP_INTERVAL_MS,
+    DEFAULT_SWEEP_INTERVAL_MS,
+    30_000,
+    "RECEIVER_SWEEP_INTERVAL_MS",
+  );
   const orchestrator = new PipelineOrchestrator({
     registry,
     detection,
     executor,
     deadLetters: new PipelineDeadLetterQueue(),
     liquidationGate,
+    ...(receiverSweeper === undefined
+      ? {}
+      : {
+        onLiquidationFilled: (fill) => receiverSweeper.scheduleAfterFill({
+          opportunityId: fill.opportunityId,
+          txHash: fill.txHash,
+          collateralAsset: fill.candidate.collateralAsset,
+          debtAsset: fill.candidate.debtAsset,
+        }),
+      }),
     simFailureCircuit,
     ...(watchlistCoordinator === undefined
       ? {}
@@ -1631,6 +1675,7 @@ function buildPipelineBot(config: RuntimeConfig, metrics: BotMetrics): BotRunner
     }
   });
   shutdown.addHook("arb_queue_stop", async () => arbQueue.stop());
+  shutdown.addHook("receiver_sweep_stop", async () => receiverSweeper?.stop());
   shutdown.addHook("oracle_poll_stop", async () => priceOracleCache?.stopBackgroundPoll());
@SP@
   return new PipelineBotRunner(
diff --git a/src/orchestrator/pipelineOrchestrator.ts b/src/orchestrator/pipelineOrchestrator.ts
index 333076a..61f7d3d 100644
--- a/src/orchestrator/pipelineOrchestrator.ts
+++ b/src/orchestrator/pipelineOrchestrator.ts
@@ -1,4 +1,4 @@
-import type { Address } from "viem";
+import type { Address, Hash } from "viem";
 import type { BotMetrics, LoggerLike } from "../bot";
 import type { ChainRegistry, CircuitBreakerName, CircuitBreakerState } from "../config/chainRegistry";
 import type { SupportedChain } from "../config/chains";
@@ -73,6 +73,16 @@ export interface PipelineOrchestratorConfig {
     opportunity: Opportunity,
   ): SafeExecutionRequest | undefined | Promise<SafeExecutionRequest | undefined>;
   readonly liquidationGate?: LiquidationCandidateGate;
+  /**
+   * Called AFTER a confirmed liquidation fill (receipt success) has been recorded/logged. Fire-and-forget: it is
+   * invoked inside its own try/catch and must never block or mask the fill result (used for the receiver sweep).
+   */
+  readonly onLiquidationFilled?: (fill: {
+    readonly chain: SupportedChain;
+    readonly opportunityId: string;
+    readonly txHash: Hash;
+    readonly candidate: LiquidationCandidate;
+  }) => void;
   readonly watchlistStaleness?: StalenessGuard;
   /** Event-watchlist periodic HF sweep (e.g. when block WS subscription is unavailable). */
   readonly watchlistSweep?: (chain: SupportedChain) => Promise<void>;
@@ -371,6 +381,8 @@ export class PipelineOrchestrator {
     try {
       const result = await this.config.executor.execute(request);
       this.recordExecutionResult(plan, request, result, summary);
+      // Fill is logged/recorded above; the sweep hook is fire-and-forget and cannot delay or mask it.
+      this.notifyLiquidationFilled(plan, request, result);
       await this.recordLearningOutcome(plan, toLearningOutcome(result));
     } catch (error) {
