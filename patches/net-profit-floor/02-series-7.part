+    const b = gate({ priceOracle: untrustedOracle });
+    await b.g.filterCandidates("base", [candidate(30_000_000n, 30)], "t");
+    expect(shadowLogs(b.logger)).toHaveLength(1);
+    expect(shadowLogs(b.logger)[0]).toMatchObject({ debtTrusted: false, net025: false, net1: false, net5: false, debt50: false, livePass: false });
+  });
+
+  it("shadow is emitted even for borrower-cooldown-free paths with oracle sanity failure, and counters accumulate", async () => {
+    const { g, logger } = gate({ oracleSanityCheck: async () => ({ pass: false, deviationPct: 9 }) });
+    await g.filterCandidates("base", [candidate(600_000_000n, 600)], "t");
+    expect(shadowLogs(logger)[0]).toMatchObject({ net5: true, debt50: true, livePass: false });
+    expect(g.floorShadowCounters.snapshot()).toMatchObject({ total: 1, net5: 1, debt50: 1, live: 0 });
+  });
+
+  it("missing gas (0 / NaN) or missing protocol fee never passes", async () => {
+    for (const gas of [0, Number.NaN]) {
+      const { g } = gate({ resolveGasCostUsd: async () => gas });
+      expect(await g.filterCandidates("base", [candidate(600_000_000n, 600)], "t")).toHaveLength(0);
+    }
+    const { g, logger } = gate();
+    expect(await g.filterCandidates("base", [candidate(600_000_000n, 600, { noProtocolFee: true })], "t")).toHaveLength(0);
+    const evaluated = logger.info.mock.calls.find((c) => c[0] === "liquidation_evaluated")![1] as Record<string, unknown>;
+    expect(evaluated).toMatchObject({ pass: false, reason: "inputs_missing", netProfitUsd: null });
+  });
+
+  it("uses the on-chain effective bonus (not the config default) and fails closed if verdict debt exceeds real on-chain debt", async () => {
+    const oracle = { forceRefreshUsdPrices: async () => ({ [debtAsset]: 100_000_000n, [collateralAsset]: 300_000_000_000n }) } as unknown as PriceOracleCache;
+    const { g, logger } = gate({ priceOracle: oracle });
+    // expected repaid raw = 600 USDC but real actual debt only 100 USDC => inconsistent => reject
+    const inconsistent = candidate(600_000_000n, 600, { actualDebtRaw: 100_000_000n, expectedDebtRepaidRaw: 600_000_000n });
+    expect(await g.filterCandidates("base", [inconsistent], "t")).toHaveLength(0);
+    expect(logger.info.mock.calls.find((c) => c[0] === "liquidation_evaluated")![1]).toMatchObject({ debtExceedsOnChainDebt: true, pass: false });
+    const consistent = candidate(600_000_000n, 600, { actualDebtRaw: 1_200_000_000n, expectedDebtRepaidRaw: 600_000_000n, effectiveLiquidationBonusBps: 1_000 });
+    const kept = await g.filterCandidates("base", [consistent], "t");
+    expect(kept).toHaveLength(1);
+    const evals = logger.info.mock.calls.filter((c) => c[0] === "liquidation_evaluated");
+    expect((evals[1]![1] as Record<string, unknown>).bonusRate).toBeCloseTo(0.1, 9);
   });
 });
