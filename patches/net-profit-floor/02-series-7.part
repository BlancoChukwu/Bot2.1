+import {
+  computeFloorShadow,
+  estimateLiquidationGasCostUsd,
+  evaluateLiquidationProfitability,
+  FloorShadowCounters,
+  type LiquidationProfitabilityInput,
+} from "../../src/profitability/liquidationProfitabilityGate";
+
+// bonus 5%, protocol fee 10% of bonus, flash 5bps, swap 30bps, slippage 20bps
+const base: LiquidationProfitabilityInput = {
+  debtUsd: 1_000,
+  liquidationBonusBps: 500,
+  liquidationProtocolFeeBps: 1_000,
+  gasCostUsd: 0.1,
+  flashFeeBps: 5,
+  swapRequired: true,
+  swapFeeBps: 30,
+  slippageBps: 20,
+  minNetProfitUsd: 1,
+  minDebtSanityUsd: 5,
+};
+
+describe("evaluateLiquidationProfitability (net-profit floor)", () => {
+  it("computes net = bonus*(1-protocolFee) - gas - flash - swapFee - slippage", () => {
+    const r = evaluateLiquidationProfitability(base);
+    // bonus 50, protocol 5 => 45 ; flash 0.5 ; swapped 1050 => fee 3.15, slip 2.1 ; gas 0.1
+    expect(r.bonusCaptureUsd).toBeCloseTo(45, 9);
+    expect(r.protocolFeeUsd).toBeCloseTo(5, 9);
+    expect(r.flashFeeUsd).toBeCloseTo(0.5, 9);
+    expect(r.swapFeeUsd).toBeCloseTo(3.15, 9);
+    expect(r.slippageUsd).toBeCloseTo(2.1, 9);
+    expect(r.netProfitUsd).toBeCloseTo(45 - 0.1 - 0.5 - 3.15 - 2.1, 9);
+    expect(r.pass).toBe(true);
+    expect(r.reason).toBe("ok");
+  });
+
+  it("$50 is no longer a hard gate: a $30 debt with positive net >= $1 PASSES; $60 with net < $1 FAILS", () => {
+    const small = evaluateLiquidationProfitability({ ...base, debtUsd: 30 });
+    expect(small.netProfitUsd!).toBeCloseTo(30 * 0.03925 - 0.1, 9); // ~1.0775
+    expect(small.pass).toBe(true);
+    const bigButGassy = evaluateLiquidationProfitability({ ...base, debtUsd: 60, gasCostUsd: 2 });
+    expect(bigButGassy.netProfitUsd!).toBeLessThan(1);
+    expect(bigButGassy.pass).toBe(false); // >$50 debt no longer implies pass
+  });
+
+  it("barely over / barely under the net floor (edge)", () => {
+    const at = evaluateLiquidationProfitability(base);
+    const perUsd = (at.netProfitUsd! + base.gasCostUsd!) / base.debtUsd; // net per $ of debt before gas
+    // Solve debt where net == 1.0 exactly
+    const debtAtFloor = (base.gasCostUsd! + 1) / perUsd;
+    const over = evaluateLiquidationProfitability({ ...base, debtUsd: debtAtFloor + 0.01 });
+    const exact = evaluateLiquidationProfitability({ ...base, debtUsd: debtAtFloor });
+    const under = evaluateLiquidationProfitability({ ...base, debtUsd: debtAtFloor - 0.01 });
+    expect(over.pass).toBe(true);
+    expect(exact.netProfitUsd!).toBeCloseTo(1, 9);
+    expect(under.pass).toBe(false);
+    expect(under.reason).toBe("below_min_net_profit");
+    expect(under.netProfitUsd!).toBeLessThan(1);
+    expect(over.dynamicFloor).toBeCloseTo(debtAtFloor, 6);
+  });
+
+  it("high gas makes a big debt fail; low gas lets a small debt pass (no $50 cliff)", () => {
+    expect(evaluateLiquidationProfitability({ ...base, debtUsd: 500, gasCostUsd: 20 }).pass).toBe(false);
+    const small = evaluateLiquidationProfitability({ ...base, debtUsd: 40, gasCostUsd: 0.02 });
+    expect(small.netProfitUsd!).toBeCloseTo(40 * 0.045 - 0.02 - 40 * 0.0005 - 42 * 0.003 - 42 * 0.002, 9);
+    expect(small.pass).toBe(small.netProfitUsd! >= 1);
+  });
+
+  it("debt sanity floor is independent: net ok but debt < sanity => fail with its own reason", () => {
+    const r = evaluateLiquidationProfitability({ ...base, debtUsd: 20, minDebtSanityUsd: 25, minNetProfitUsd: 0.01 });
+    expect(r.netProfitUsd!).toBeGreaterThan(0.01);
+    expect(r.pass).toBe(false);
+    expect(r.reason).toBe("below_debt_sanity_floor");
+  });
+
+  it("same-asset (no swap leg) omits swap fee + slippage and needs no swap inputs", () => {
+    const r = evaluateLiquidationProfitability({ ...base, swapRequired: false, swapFeeBps: undefined, slippageBps: undefined });
+    expect(r.inputsOk).toBe(true);
+    expect(r.swapFeeUsd).toBe(0);
+    expect(r.slippageUsd).toBe(0);
   });
@SP@
