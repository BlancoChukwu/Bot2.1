   return {
-    pass: input.debtUsd >= effectiveFloor,
-    dynamicFloor,
-    hardFloor,
-    effectiveFloor,
-    gasCostUsd: input.gasCostUsd,
-    flashFeeUsd,
-    bonusRate: effectiveBonusRate,
+    pass: netPass && sanityPass,
+    reason: !netPass ? "below_min_net_profit" : !sanityPass ? "below_debt_sanity_floor" : "ok",
+    inputsOk: true,
+    missingInputs: [],
     netProfitUsd,
+    bonusCaptureUsd,
+    protocolFeeUsd,
+    gasCostUsd,
+    flashFeeUsd,
+    swapFeeUsd,
+    slippageUsd,
+    bonusRate,
+    minNetProfitUsd: input.minNetProfitUsd,
+    minDebtSanityUsd: input.minDebtSanityUsd,
+    dynamicFloor,
+    hardFloor: input.minDebtSanityUsd,
+    effectiveFloor: Math.max(dynamicFloor, input.minDebtSanityUsd),
+  };
+}
+
+/** Would-pass flags for the 24h SIM floor comparison. Pure net-profit flags (sanity floor reported separately). */
+export interface FloorShadow {
+  readonly net025: boolean;
+  readonly net1: boolean;
+  readonly net5: boolean;
+  /** Legacy: debtUsd >= $50 (trusted debt only). */
+  readonly debt50: boolean;
+  /** debtUsd >= the configured sanity floor. */
+  readonly sanity: boolean;
+  readonly inputsOk: boolean;
+  /** Live verdict (net floor + sanity floor + trusted debt). */
+  readonly live: boolean;
+}
+
+export function computeFloorShadow(
+  result: LiquidationProfitabilityResult,
+  debtUsd: number,
+  debtTrusted: boolean,
+): FloorShadow {
+  const net = result.inputsOk && debtTrusted ? result.netProfitUsd : null;
+  const atLeast = (floor: number): boolean => net !== null && net >= floor;
+  return {
+    net025: atLeast(0.25),
+    net1: atLeast(1),
+    net5: atLeast(5),
+    debt50: debtTrusted && Number.isFinite(debtUsd) && debtUsd >= SHADOW_DEBT_FLOOR_USD,
+    sanity: debtTrusted && Number.isFinite(debtUsd) && debtUsd >= result.minDebtSanityUsd,
+    inputsOk: result.inputsOk && debtTrusted,
+    live: debtTrusted && result.pass,
   };
 }
+
+export class FloorShadowCounters {
+  public total = 0;
+  public net025 = 0;
+  public net1 = 0;
+  public net5 = 0;
+  public debt50 = 0;
+  public live = 0;
+  public inputsMissing = 0;
+
+  public record(shadow: FloorShadow): void {
+    this.total += 1;
+    if (shadow.net025) this.net025 += 1;
+    if (shadow.net1) this.net1 += 1;
+    if (shadow.net5) this.net5 += 1;
+    if (shadow.debt50) this.debt50 += 1;
+    if (shadow.live) this.live += 1;
+    if (!shadow.inputsOk) this.inputsMissing += 1;
+  }
+
+  public snapshot(): Record<string, number> {
+    return {
+      total: this.total,
+      net025: this.net025,
+      net1: this.net1,
+      net5: this.net5,
+      debt50: this.debt50,
+      live: this.live,
+      inputsMissing: this.inputsMissing,
+    };
+  }
+}
