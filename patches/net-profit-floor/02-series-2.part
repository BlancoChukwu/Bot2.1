@@ -26,6 +26,7 @@ export interface Phase2TargetedDryRunConfig {
   readonly fallbackRpcUrls: readonly string[];
   readonly aaveSubgraphUrl: string;
   readonly minLiquidationDebtUsd: number;
+  readonly minNetProfitUsd: number;
   readonly borrowerDeadLetterCooldownMs: number;
   readonly oracleMaxStaleMs: number;
   readonly oraclePollIntervalMs: number;
@@ -104,7 +105,9 @@ export async function runPhase2TargetedDustDryRun(
   };
@SP@
   const gate = new LiquidationCandidateGate({
-    minDebtUsd: input.config.minLiquidationDebtUsd,
+    minNetProfitUsd: input.config.minNetProfitUsd,
+    minDebtSanityUsd: input.config.minLiquidationDebtUsd,
+    resolveSlippageBps: async () => input.config.slippageBps,
     resolveGasCostUsd,
     resolveFlashFeeBps: async () => input.config.flashLoanFeeBps,
     ...(priceOracle === undefined ? {} : { priceOracle }),
diff --git a/src/index.ts b/src/index.ts
index c2a0d60..2bc2b55 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -182,7 +182,10 @@ export interface RuntimeConfig {
   readonly dailyPnlCsvPath: string | undefined;
   readonly arbitrageMinProfitUsd: number;
   readonly priceFeedRegistry: OracleFeedRegistry | undefined;
+  /** Small-debt SANITY floor (MIN_DEBT_SANITY_USD, default $5). Not a profitability gate. */
   readonly minLiquidationDebtUsd: number;
+  /** Net-profit floor (MIN_NET_PROFIT_USD, default $1): gas + flash premium + swap fee + slippage netted out. */
